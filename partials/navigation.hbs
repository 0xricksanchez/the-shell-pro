{{#if isSecondary}}
    <ul class="footer-nav__links">
        {{#foreach navigation as |item|}}
            <li class="nav-{{item.slug}}{{#if item.current}} nav-current{{/if}}">
                <a href="{{item.url}}"{{#if item.current}} aria-current="page"{{/if}}>{{item.label}}</a>
            </li>
        {{/foreach}}
    </ul>
{{else}}
    <nav class="site-nav" aria-label="Primary navigation">
        <button class="site-nav__toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-navigation">
            <span class="visually-hidden">Toggle navigation</span>
            <span aria-hidden="true">☰</span>
        </button>
        <div class="site-nav__menu" id="site-navigation" data-menu>
            <ul>
                {{#foreach navigation as |item|}}
                    <li class="nav-{{item.slug}}{{#if item.current}} nav-current{{/if}}">
                        <a href="{{item.url}}"{{#if item.current}} aria-current="page"{{/if}}>{{item.label}}</a>
                    </li>
                {{/foreach}}
            </ul>
        </div>
    </nav>
{{/if}}
