<article class="post-card {{post_class}} {{#if feature_image}}post-card--with-image{{else}}post-card--text-only{{/if}}">
    {{#if feature_image}}
        <a class="post-card__image" href="{{url}}" tabindex="-1" aria-hidden="true">
            <picture>
                <source
                    type="image/webp"
                    srcset="{{img_url feature_image size="s" format="webp"}} 600w,
                            {{img_url feature_image size="m" format="webp"}} 1000w,
                            {{img_url feature_image size="l" format="webp"}} 1600w"
                    sizes="(max-width: 720px) 92vw, 360px">
                <img
                    src="{{img_url feature_image size="m"}}"
                    srcset="{{img_url feature_image size="s"}} 600w,
                            {{img_url feature_image size="m"}} 1000w,
                            {{img_url feature_image size="l"}} 1600w"
                    sizes="(max-width: 720px) 92vw, 360px"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                    loading="lazy">
            </picture>
        </a>
    {{/if}}
    <div class="post-card__body">
        {{> "post-type" hide_fallback=true}}
        <div class="post-card__meta">
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
            {{#primary_tag}}<a href="{{url}}">{{name}}</a>{{/primary_tag}}
        </div>
        <h2><a href="{{url}}">{{title}}</a></h2>
        {{#if custom_excerpt}}
            <p>{{custom_excerpt}}</p>
        {{else}}
            <p>{{excerpt words="32"}}</p>
        {{/if}}
        <a class="post-card__read" href="{{url}}">Read entry <span aria-hidden="true">→</span></a>
    </div>
</article>
