{{!< default}}

<main id="main-content" class="site-main site-main--home">
    <header class="home-hero"{{#if @site.cover_image}} style="--hero-image: url({{img_url @site.cover_image size="l" format="webp"}}); --hero-image-small: url({{img_url @site.cover_image size="s" format="webp"}});"{{/if}}>
        <div class="home-hero__grid" aria-hidden="true"></div>
        <div class="home-hero__content">
            <p class="eyebrow">// technical transmission</p>
            <h1>{{@site.title}}</h1>
            {{#if @site.description}}<p>{{@site.description}}</p>{{/if}}
            <ul class="home-hero__status" aria-label="Publication status">
                <li><span aria-hidden="true"></span> channel open</li>
                <li>Ghost 6</li>
                <li>research / engineering</li>
            </ul>
            <div class="home-hero__actions">
                <a class="button" href="#latest">Read latest <span aria-hidden="true">↓</span></a>
                {{#if @site.members_enabled}}
                    <a class="button button--quiet" href="#/portal/signup">Get updates</a>
                {{/if}}
            </div>
        </div>
    </header>

    <section class="lab-index" aria-label="Research topics">
        <div class="lab-index__heading">
            <h2 class="visually-hidden">Research topics</h2>
            <p class="eyebrow">// lab index</p>
        </div>
        <div class="lab-index__tags">
            {{#get "tags" limit="12" order="count.posts desc" include="count.posts" filter="slug:-field-note+slug:-deep-dive+slug:-lab-log+slug:-tool-release+slug:-advisory+slug:-preview"}}
                {{#foreach tags}}
                    <a href="{{url}}">{{name}} <span>{{count.posts}}</span></a>
                {{/foreach}}
            {{/get}}
        </div>
    </section>

    <section class="post-feed home-feed" id="latest" aria-label="Latest posts">
        <div class="section-heading">
            <h2 class="visually-hidden">Latest dispatches</h2>
            <p class="eyebrow">// latest dispatches</p>
        </div>
        {{#foreach posts}}
            {{> "post-card"}}
        {{/foreach}}
    </section>

    {{pagination}}
</main>
