{{!< default}}

<main id="main-content" class="site-main">
    <header class="listing-header">
        <p class="eyebrow">// index</p>
        <h1>Archive</h1>
        <p>The latest 100 published entries.</p>
    </header>
    <section class="archive-list" aria-label="Archive">
        {{#get "posts" limit="100" order="published_at desc"}}
            {{#foreach posts}}
                <article>
                    <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="YYYY.MM.DD"}}</time>
                    <a href="{{url}}">{{title}}</a>
                    {{#primary_tag}}<span>{{name}}</span>{{/primary_tag}}
                </article>
            {{/foreach}}
        {{/get}}
    </section>
</main>
