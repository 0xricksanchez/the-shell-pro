{
  "name": "the-shell-pro",
  "version": "2.0.9",
  "description": "A Ghost in the Shell-inspired technical publishing theme for Ghost 6.",
  "license": "GPL-3.0",
  "author": {
    "name": "Neulana",
    "email": "fupinyou@gmail.com",
    "url": "https://github.com/Neulana"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Neulana/the-shell-pro.git"
  },
  "engines": {
    "ghost": ">=6.0.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "check:preview": "node scripts/check-preview.mjs"
  },
  "config": {
    "posts_per_page": 10,
    "card_assets": true,
    "custom": {
      "show_comments": {
        "type": "boolean",
        "default": false,
        "description": "Show Ghost comments below technical posts"
      },
      "pgp_fingerprint": {
        "type": "text",
        "default": "",
        "description": "Public PGP key fingerprint shown in the footer colophon (leave empty to hide)"
      },
      "pgp_key_url": {
        "type": "text",
        "default": "",
        "description": "Optional link target for the footer PGP fingerprint (keyserver or .asc file)"
      }
    },
    "image_sizes": {
      "xs": {
        "width": 300
      },
      "s": {
        "width": 600
      },
      "m": {
        "width": 1000
      },
      "l": {
        "width": 1600
      },
      "xl": {
        "width": 2400
      }
    }
  },
  "keywords": [
    "ghost",
    "ghost-theme",
    "technical-blog",
    "dark"
  ]
}
