{{!< default}}

{{#author}}
<main id="main-content" class="site-main">
    <header class="listing-header listing-header--author">
        {{#if profile_image}}<img src="{{img_url profile_image size="s"}}" alt="{{name}}">{{/if}}
        <div>
            <p class="eyebrow">// author</p>
            <h1>{{name}}</h1>
            {{#if bio}}<p>{{bio}}</p>{{/if}}
        </div>
    </header>
{{/author}}
    <section class="post-feed home-feed archive-feed" aria-label="Posts by this author">
        {{#foreach posts}}
            {{> "post-card"}}
        {{/foreach}}
    </section>
    {{pagination}}
</main>
