{{!< default}}

{{#author}}
<main id="main-content" class="site-main">
    <header class="listing-header listing-header--author">
        {{#if profile_image}}<img src="{{img_url profile_image size="s"}}" alt="{{name}}" width="300" height="300">{{/if}}
        <div>
            {{> "breadcrumbs" current=name}}
            <p class="eyebrow">// author</p>
            <h1>{{name}}</h1>
            {{#if bio}}<p>{{bio}}</p>{{/if}}
            {{#if website}}<p class="listing-header__links"><a href="{{website}}" rel="me">Website <span aria-hidden="true">↗</span></a></p>{{/if}}
        </div>
    </header>
{{/author}}
    <section class="post-feed home-feed archive-feed" aria-label="Posts by this author">
        {{#foreach posts}}
            {{> "post-card" eager_image=@first}}
        {{/foreach}}
    </section>
    {{pagination}}
</main>
