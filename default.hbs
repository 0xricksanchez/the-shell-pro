<!doctype html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#111822">
    {{#unless @site.is_private}}<meta name="robots" content="max-image-preview:large">{{/unless}}
    <title>{{meta_title}}</title>
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
    <noscript>
        <style>
            @media (max-width: 960px) {
                .site-header__inner { flex-wrap: wrap; padding: .55rem 0; }
                .site-nav { flex: 1 0 100%; }
                .site-nav__toggle { display: none; }
                .site-nav__menu {
                    position: static;
                    display: block;
                    padding: .25rem 0;
                    border: 0;
                    background: transparent;
                    box-shadow: none;
                }
                .site-nav__menu ul { display: flex; }
            }
        </style>
    </noscript>
    {{#if @site.accent_color}}
    <style>:root { --shell-accent: {{@site.accent_color}}; }</style>
    {{/if}}
    <link rel="preload" href="{{asset "fonts/mona-krypton.woff2"}}" as="font" type="font/woff2" crossorigin>
    {{ghost_head}}
</head>
<body class="{{body_class}}">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
        <div class="site-header__inner">
            <a class="site-brand" href="{{@site.url}}" aria-label="{{@site.title}} home">
                {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}">
                {{else}}
                    <span class="site-brand__mark" aria-hidden="true">▣</span>
                    <span>{{@site.title}}</span>
                {{/if}}
            </a>

            {{#if @site.navigation}}
                {{navigation}}
            {{/if}}

            <div class="site-actions">
                <button class="icon-button" type="button" data-ghost-search aria-label="Search">
                    <span aria-hidden="true">⌕</span>
                </button>
                <button class="back-to-top" type="button" data-back-to-top aria-label="Back to top" hidden>↑</button>
                {{#if @site.members_enabled}}
                    {{#if @member}}
                        <a class="button button--quiet" href="#/portal/account">Account</a>
                    {{else}}
                        <a class="button button--quiet" href="#/portal/signup">Subscribe</a>
                    {{/if}}
                {{/if}}
            </div>
        </div>
    </header>

    {{{body}}}

    <footer class="site-footer">
        <div class="site-footer__inner">
            <div class="site-footer__identity">
                <p><span class="prompt" aria-hidden="true">$</span> {{@site.title}} <span class="muted">© {{date format="YYYY"}}</span></p>
                <p class="site-footer__status">independent technical publishing</p>
                {{#get "posts" limit="1" order="published_at desc" as |latest|}}
                    {{#foreach latest}}
                        <p class="site-footer__transmission">
                            <span class="site-footer__transmission-dot" aria-hidden="true"></span>
                            <span>last transmission</span>
                            <a href="{{url}}"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time></a>
                        </p>
                    {{/foreach}}
                {{/get}}
                {{#if @custom.pgp_fingerprint}}
                    <p class="site-footer__pgp">
                        <span class="site-footer__pgp-label" aria-hidden="true">PGP</span>
                        <span class="visually-hidden">PGP fingerprint</span>
                        {{#if @custom.pgp_key_url}}
                            <a href="{{@custom.pgp_key_url}}">{{@custom.pgp_fingerprint}}</a>
                        {{else}}
                            <span>{{@custom.pgp_fingerprint}}</span>
                        {{/if}}
                    </p>
                {{/if}}
            </div>
            {{#if @site.secondary_navigation}}
                <nav class="site-footer__navigate" aria-label="Footer navigation">
                    <p class="eyebrow">// navigate</p>
                    {{navigation type="secondary"}}
                </nav>
            {{/if}}
        </div>
        <div class="site-footer__rail">
            <div class="site-footer__rail-inner">
                {{> "social-links"}}
                {{#if @site.members_enabled}}<a class="site-footer__member" href="#/portal/account">Member account</a>{{/if}}
            </div>
        </div>
    </footer>

    {{ghost_foot}}
    <script src="{{asset "js/shell.js"}}"></script>
</body>
</html>
