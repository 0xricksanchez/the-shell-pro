<!doctype html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#111822">
    <title>{{meta_title}}</title>
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
    {{#if @site.accent_color}}
    <style>:root { --shell-accent: {{@site.accent_color}}; }</style>
    {{/if}}
    {{ghost_head}}
</head>
<body class="{{body_class}}">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="reading-progress" data-reading-progress aria-hidden="true" hidden><span></span></div>

    <header class="site-header">
        <div class="site-header__inner">
            <a class="site-brand" href="{{@site.url}}" aria-label="{{@site.title}} home">
                {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}">
                {{else}}
                    <span class="site-brand__mark" aria-hidden="true">▣</span>
                    <span>{{@site.title}}</span>
                {{/if}}
            </a>

            {{#if @site.navigation}}
                {{navigation}}
            {{/if}}

            <div class="site-actions">
                <button class="icon-button" type="button" data-ghost-search aria-label="Search">
                    <span aria-hidden="true">⌕</span>
                </button>
                <button class="back-to-top" type="button" data-back-to-top aria-label="Back to top" hidden>↑</button>
                {{#if @site.members_enabled}}
                    {{#if @member}}
                        <a class="button button--quiet" href="#/portal/account">Account</a>
                    {{else}}
                        <a class="button button--quiet" href="#/portal/signup">Subscribe</a>
                    {{/if}}
                {{/if}}
            </div>
        </div>
    </header>

    {{{body}}}

    <footer class="site-footer">
        <div class="site-footer__inner">
            <div class="site-footer__identity">
                <p><span class="prompt" aria-hidden="true">$</span> {{@site.title}} <span class="muted">© {{date format="YYYY"}}</span></p>
                <p class="site-footer__status">independent technical publishing</p>
            </div>
            <div class="site-footer__navigation">
                {{#if @site.secondary_navigation}}
                    <nav class="footer-nav" aria-label="Secondary navigation">
                        {{navigation type="secondary"}}
                    </nav>
                {{/if}}
                <div class="site-footer__links" aria-label="Publication links">
                    <a href="{{@site.url}}/rss/">RSS</a>
                    {{#if @site.twitter}}<a href="{{social_url type="twitter"}}" rel="me">Social</a>{{/if}}
                    {{#if @site.members_enabled}}<a href="#/portal/account">Member account</a>{{/if}}
                </div>
            </div>
        </div>
    </footer>

    {{ghost_foot}}
    {{#is "post, page"}}
        <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js" referrerpolicy="no-referrer"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/x86asm.min.js" referrerpolicy="no-referrer"></script>
    {{/is}}
    <script src="{{asset "js/shell.js"}}"></script>
</body>
</html>
