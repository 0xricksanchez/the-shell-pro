{{!< default}}

{{#post}}
<main id="main-content" class="site-main site-main--article">
    <article class="article article--page {{post_class}}">
        {{#if @page.show_title_and_feature_image}}
            <header class="article-header">
                <div class="article-header__content">
                    {{> "breadcrumbs" current=title}}
                    {{> "reader-tools"}}
                    <p class="eyebrow">// reference</p>
                    <h1>{{title}}</h1>
                    {{#if custom_excerpt}}<p class="article-header__excerpt">{{custom_excerpt}}</p>{{/if}}
                </div>
                {{#if feature_image}}
                    <figure class="article-feature-image article-feature-image--page">
                        <picture>
                            <source
                                type="image/webp"
                                srcset="{{img_url feature_image size="m" format="webp"}} 1000w,
                                        {{img_url feature_image size="l" format="webp"}} 1600w,
                                        {{img_url feature_image size="xl" format="webp"}} 2400w"
                                sizes="(min-width: 1280px) 1120px, 92vw">
                            <img
                                src="{{img_url feature_image size="l"}}"
                                srcset="{{img_url feature_image size="m"}} 1000w,
                                        {{img_url feature_image size="l"}} 1600w,
                                        {{img_url feature_image size="xl"}} 2400w"
                                sizes="(min-width: 1280px) 1120px, 92vw"
                                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{/if}}"
                                fetchpriority="high">
                        </picture>
                        {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
                    </figure>
                {{/if}}
            </header>
        {{/if}}
        {{#unless @page.show_title_and_feature_image}}
            <h1 class="visually-hidden">{{title}}</h1>
        {{/unless}}
        <div class="article-layout">
            <aside class="article-toc" data-toc-container>
                <nav class="toc" data-toc aria-label="Article navigation">
                    <p class="toc__title">On this page</p>
                </nav>
            </aside>
            <section class="article-content" data-post-content>
                {{content}}
            </section>
        </div>
        {{#if @custom.show_comments}}
            {{#if @site.comments_enabled}}
            <footer class="article-footer article-comments" aria-label="Comments">{{comments mode="dark" title="Discussion" count=false}}</footer>
            {{/if}}
        {{/if}}
    </article>
</main>
{{/post}}
